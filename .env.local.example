NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL pública do site (usado nos links dos e-mails)
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Resend (https://resend.com) — notificações por e-mail
RESEND_API_KEY=re_your_api_key
# Endereço remetente verificado no Resend (ex: portal@seudominio.com.br)
# Em testes: onboarding@resend.dev  (só envia para o dono da conta)
RESEND_FROM_EMAIL=Portal Viver Bem <portal@seudominio.com.br>
